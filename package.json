{
  "name": "idmint",
  "version": "1.1.0",
  "description": "Enterprise-grade, collision-resistant unique ID generator",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "keywords": [
    "unique-id",
    "uid",
    "nanoid",
    "uuid",
    "id-generator",
    "short-id",
    "enterprise",
    "secure"
  ],
  "author": "Vikram Singh Rajpurohit",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/beingviksa/idmint"
  },
  "bugs": {
    "url": "https://github.com/beingviksa/idmint/issues"
  },
  "homepage": "https://github.com/beingviksa/idmint#readme"
}
